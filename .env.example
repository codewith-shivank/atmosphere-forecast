# ─────────────────────────────────────────────────────────────────────────────
# Atmosphere Weather — Environment Variables
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# This project currently uses only free, key-less public APIs (Open-Meteo &
# BigDataCloud), so no API keys are required out of the box.
# The variables below are reserved for future enhancements.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
# Override the default port for the Vite dev server (default: 3000)
# VITE_DEV_PORT=3000

# ── Weather API (future) ──────────────────────────────────────────────────────
# If you switch to a provider that requires a key (e.g. OpenWeatherMap),
# add it here and reference it in src/services/weatherApi.ts.
# VITE_WEATHER_API_KEY=your_api_key_here
# VITE_WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5

# ── Back-end / Database (future) ──────────────────────────────────────────────
# If you add a Node/Express + MongoDB layer for saved cities / user prefs:
# VITE_API_BASE_URL=http://localhost:4000/api
# MONGODB_URI=mongodb://localhost:27017/atmosphere
# JWT_SECRET=change_me_before_production

# ── Analytics (optional) ──────────────────────────────────────────────────────
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
